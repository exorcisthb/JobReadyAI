# NextAuth Configuration
# Get these from Google Cloud Console
# Vite exposes only variables prefixed with VITE_ to browser code.
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# PostgreSQL connection for the local API server.
DATABASE_URL=postgresql://postgres:12345678@localhost:5432/exe1
# Set to true for hosted PostgreSQL providers that require SSL.
DATABASE_SSL=false
PORT=3001

# Legacy server-side names kept only if you later add a backend again.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Get these from Facebook Developer
VITE_FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Auth.js / NextAuth Secret (generate with: openssl rand -base64 32)
AUTH_SECRET=your_auth_secret_here
AUTH_URL=http://localhost:3000

# Optional aliases kept for older NextAuth examples/tools
NEXTAUTH_SECRET=your_auth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Admin Seed Account (will be created automatically on server startup)
ADMIN_PHONE=0900000000
ADMIN_PASSWORD=admin_secure_password_123

