# ===== Auth =====
AUTH_SECRET=your_auth_secret_here
AUTH_URL=http://localhost:3000

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# ===== Facebook OAuth =====
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
VITE_FACEBOOK_APP_ID=your_facebook_app_id

# ===== Vercel deployment =====
# Optional override for local development only; production API is same-origin.
# VITE_API_URL=http://localhost:3001
ALLOWED_ORIGINS=https://jobreadyai.vn,https://www.jobreadyai.vn,https://*.vercel.app
FRONTEND_URL=https://jobreadyai.vn
CRON_SECRET=generate_a_long_random_secret

# ===== Database =====
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
DATABASE_SSL=false

# ===== Gemini AI =====
GEMINI_API_KEY=your_gemini_api_key

# ===== Admin =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# ===== Email (Brevo) =====
BREVO_API_KEY=your_brevo_api_key
BREVO_FROM_EMAIL=your_email@example.com

# ===== PDF Render =====
PDF_RENDER_BASE_URL=http://localhost:3000

# ===== PayOS =====
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_RETURN_URL=https://jobreadyai.vn/payment/success
PAYOS_CANCEL_URL=https://jobreadyai.vn/payment/cancel
PAYOS_WEBHOOK_URL=https://jobreadyai.vn/api/payment/webhook

# ===== Cloudflare R2 (S3-compatible) =====
AWS_REGION=auto
AWS_BUCKET_NAME=your_bucket_name
AWS_ACCESS_KEY_ID=your_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_r2_secret_access_key
AWS_S3_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
AWS_S3_PUBLIC_URL=https://your_public_r2_url.r2.dev

# ===== Clerk Authentication =====
# Frontend publishable key (safe to expose)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
# Backend secret key (NEVER expose this publicly)
CLERK_SECRET_KEY=sk_test_your_secret_key
